# 운영 서버 /opt/familyfitness/.env 의 예시 파일. 이 파일에는 진짜 값을 적지 않는다.
# server-setup.sh 가 서버에 .env 가 없을 때 이 파일을 복사하고, POSTGRES_PASSWORD 와 APP_JWT_SECRET 을 무작위로,
# BE_PRIVATE_IP 를 서버의 사설 IP 로 채운다. 나머지 빈 칸은 서버에서 채운다: sudo -u ubuntu nano /opt/familyfitness/.env
# 고친 뒤에는 서버에서 cd /opt/familyfitness && docker compose up -d 로 다시 띄운다.

# app 이미지. deploy.sh 가 배포할 때마다 이 줄을 고친다(비워 둔다)
BACKEND_IMAGE=

# FE 가 BE 를 부르는 사설 IP. app 은 이 주소와 127.0.0.1 의 8080 에서만 받는다
BE_PRIVATE_IP=

# DB 비밀번호. postgres 와 app 이 같이 쓴다.
# DB 를 처음 만들 때만 쓰이므로, 그 뒤에 이 줄만 바꾸면 app 이 DB 에 붙지 못한다
POSTGRES_PASSWORD=

# JWT 서명 키(32자 이상). 바꾸면 모든 사람의 로그인이 풀린다
APP_JWT_SECRET=

# 구글 로그인. FE 의 NEXT_PUBLIC_GOOGLE_CLIENT_ID 와 같은 OAuth 클라이언트. 비워 두면 구글 로그인만 안 되고 심사용 로그인은 된다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# FE 주소(https:// 로 시작). 초대 링크 앞머리다. 비워 두면 app 이 뜨지 않는다. 예: https://d249o1o9c1vnhc.cloudfront.net
APP_FRONTEND_BASE_URL=

# 브라우저 출처(FE 주소). 꼭 적는다. FE 의 Next 서버를 거쳐 와도 브라우저가 붙인 Origin 헤더가 그대로 넘어온다.
# 여기에 없으면 POST 가 모두 403 「Invalid CORS request」 로 막혀 심사용 로그인과 구글 로그인이 되지 않는다.
# 적지 않으면 기본값인 localhost 주소들만 받는다.
APP_CORS_ALLOWED_ORIGINS=https://d249o1o9c1vnhc.cloudfront.net

# AI 서버(ff-ai)의 사설 IP 주소. 적지 않으면 app 컨테이너 안의 localhost:8000 을 불러 실패하고, 편성은 대체 편성으로 짠다.
# AI 에는 인증이 없어 공인 IP 에 열지 않는다(backend/README.md 「AI 서비스」)
APP_AI_BASE_URL=http://172.26.9.167:8000

# 아래는 적지 않으면 application.properties 기본값을 쓴다. 쓸 줄만 # 을 지운다.

# 심사용 계정 로그인. 기본은 켬, 2026-10-31 까지
# APP_AUTH_REVIEW_LOGIN_ENABLED=false
# APP_AUTH_REVIEW_LOGIN_UNTIL=2026-11-30

# JVM 옵션(기본값은 compose.yaml). 서버를 2GB 로 올리면 -Xmx 를 512m 로 올려도 된다
# JAVA_TOOL_OPTIONS=-Xmx256m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k -XX:+ExitOnOutOfMemoryError
